{
  "name": "spiral",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "vitest run",
    "test:backend": "cd src-tauri && cargo test",
    "lint:skins": "vitest run src/lib/skinLayout.test.ts",
    "read-tags": "cargo run --manifest-path src-tauri/Cargo.toml --bin read_tags --",
    "remove-registration-card": "node scripts/remove-registration-card.mjs",
    "mint:provisional": "cargo run --manifest-path src-tauri/Cargo.toml --bin license_mint -- provisional",
    "mint:finalize": "cargo run --manifest-path src-tauri/Cargo.toml --bin license_mint -- finalize",
    "mint:serve": "cargo run --manifest-path src-tauri/Cargo.toml --bin license_mint -- serve",
    "mint:provisional:default": "npm run mint:provisional -- --purchase-id poc-default --out ./tools/license-mint/poc-default.spcard",
    "mint:provisional:founder": "npm run mint:provisional -- --purchase-id poc-founder --sku founder --out ./tools/license-mint/poc-founder.spcard",
    "mint:ready:default": "npm run mint:provisional -- --purchase-id poc-ready --refund-days 0 --buffer-mins 0 --out ./tools/license-mint/poc-ready.spcard",
    "mint:ready:founder": "npm run mint:provisional -- --purchase-id poc-ready-founder --sku founder --refund-days 0 --buffer-mins 0 --out ./tools/license-mint/poc-ready-founder.spcard",
    "mint:permanent:default": "npm run mint:provisional -- --purchase-id poc-permanent --refund-days 0 --buffer-mins 0 --out ./tools/license-mint/poc-permanent.spcard && npm run mint:finalize -- --purchase-id poc-permanent >/dev/null && npm run mint:provisional -- --purchase-id poc-permanent --out ./tools/license-mint/poc-permanent.spcard",
    "tauri": "tauri",
    "prepare": "husky",
    "lint:commit": "commitlint --last --verbose",
    "check:version": "node scripts/check-version-sync.mjs",
    "clean:target": "cd src-tauri && cargo clean",
    "release:installer": "node scripts/release/build-installer.mjs",
    "release:dmg": "node scripts/release/build-installer.mjs dmg",
    "release:nsis": "node scripts/release/build-installer.mjs nsis"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@tanstack/react-virtual": "^3.14.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-opener": "^2",
    "framer-motion": "^12.38.0",
    "gifuct-js": "^2.1.2",
    "howler": "^2.2.4",
    "i18next": "^26.3.6",
    "node-vibrant": "^4.0.4",
    "postcss": "^8.5.16",
    "postcss-prefix-selector": "^2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.184.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/howler": "^2.2.12",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.6.0",
    "happy-dom": "^20.10.2",
    "husky": "^9.1.7",
    "typescript": "~5.8.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.7"
  }
}
