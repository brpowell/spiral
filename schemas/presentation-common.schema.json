{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/spiral-powered/spk-format/main/schemas/presentation-common.schema.json",
  "title": "Spiral presentation shared atoms",
  "$defs": {
    "assetRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^assets/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.(png|webp|gif|webm|mp4)$",
      "description": "Contribution-relative path under assets/, including the assets/ prefix and file extension (e.g. assets/bg-far.png). No .., absolute, or drive paths."
    },
    "skinAssetFile": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\][^\\\\]*\\.(png|gif|webp|jpe?g)$",
      "description": "Pack-relative file path under assets/, including extension."
    },
    "interactiveAssets": {
      "type": "object",
      "required": ["default"],
      "additionalProperties": false,
      "properties": {
        "default": { "$ref": "#/$defs/skinAssetFile" },
        "hover": { "$ref": "#/$defs/skinAssetFile" },
        "pressed": { "$ref": "#/$defs/skinAssetFile" },
        "disabled": { "$ref": "#/$defs/skinAssetFile" }
      }
    },
    "interactiveAssetsWhen": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/interactiveAssets" },
      "description": "Bind path → asset set when truthy (last match wins)."
    },
    "bindExpression": {
      "type": "string",
      "minLength": 1,
      "description": "Skin bind path evaluated for visibility or drive input."
    },
    "driveBinding": {
      "oneOf": [
        { "type": "number" },
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["drive"],
          "properties": {
            "drive": { "type": "string", "minLength": 1 },
            "map": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 4,
              "maxItems": 4
            },
            "value": { "type": "number" }
          }
        }
      ]
    },
    "presentationTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on"],
      "properties": {
        "on": { "type": "string", "minLength": 1 },
        "clip": { "type": "string" }
      }
    },
    "timelineClip": {
      "type": "object",
      "additionalProperties": true,
      "description": "Reserved. Unused — do not treat as a clip sequencer."
    }
  }
}
