{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/spiral-powered/spk-format/main/schemas/skin-v1.schema.json",
  "title": "Spiral skin mode manifest v1",
  "type": "object",
  "required": ["id", "name", "author", "description", "defaultView", "views"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference",
      "description": "JSON Schema reference for editor validation."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Declared contribution id. Effective id is authorId.packId.type.id at scan time."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Human-readable display label."
    },
    "author": {
      "type": "string",
      "maxLength": 80,
      "description": "Freeform credit for the contribution's creator. Independent of pack.json authorId (pack maintainer/distributor)."
    },
    "description": {
      "type": "string",
      "maxLength": 280,
      "description": "Short summary for lists/cards; keep longer notes in the pack README."
    },
    "preview": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*\\.\\.)(?!/).+\\.(png|jpg|jpeg|webp|gif)$",
      "description": "Optional preview image path relative to the contribution directory. Raster only: png, jpg, jpeg, webp, gif."
    },
    "defaultView": { "type": "string", "minLength": 1 },
    "views": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/view" }
    },
    "visualizer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Effective visualizer contribution id (authorId.packId.type.contributionId), or \"global\" to follow the user's active visualizer picker. Omit id to use global."
        },
        "placement": {
          "type": "string",
          "enum": ["top", "bottom"],
          "description": "Where the visualizer band sits in the skin shell."
        },
        "display": {
          "type": "string",
          "enum": ["mini", "panel"],
          "description": "mini = compact strip; panel = fills the visualizer slot."
        },
        "size": { "$ref": "#/$defs/visualizerSize" }
      }
    },
    "animations": {
      "type": "object",
      "description": "Reserved for declarative timelines (#17)."
    },
    "timelines": {
      "type": "object",
      "description": "Reserved for declarative timelines (#17)."
    },
    "stylesheet": {
      "type": "string",
      "description": "Optional CSS file path relative to the skin pack root (e.g. skin.css). The runtime auto-prefixes every selector with [data-skin-id] for sandboxing — authors write plain selectors."
    },
    "soundEffects": {
      "type": "object",
      "description": "Optional UI sound assets keyed by logical id (paths under assets/ without extension; .wav on disk).",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "skinAssetFile": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\][^\\\\]*\\.(png|gif|webp|jpe?g)$",
      "description": "Pack-relative file path under assets/, including extension."
    },
    "interactiveAssets": {
      "type": "object",
      "required": ["default"],
      "additionalProperties": false,
      "properties": {
        "default": { "$ref": "#/$defs/skinAssetFile" },
        "hover": { "$ref": "#/$defs/skinAssetFile" },
        "pressed": { "$ref": "#/$defs/skinAssetFile" }
      }
    },
    "interactiveAssetsWhen": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/interactiveAssets" },
      "description": "Bind path → asset set when truthy (last match wins)."
    },
    "view": {
      "type": "object",
      "required": ["layout"],
      "additionalProperties": false,
      "properties": {
        "presentation": {
          "type": "string",
          "enum": ["primary", "exclusive", "auxiliary"],
          "description": "How the runtime manages the native window for this view."
        },
        "layoutMode": {
          "type": "string",
          "enum": ["slots", "canvas"],
          "default": "slots",
          "description": "slots = SkinShell regions (default); canvas = absolute bounds. Canvas views default to dragInference auto."
        },
        "dragInference": {
          "type": "string",
          "enum": ["auto", "manual"],
          "description": "Window drag inference. Runtime default: auto when layoutMode is canvas, manual for slots. Override per view or via window.dragInference."
        },
        "canvas": { "$ref": "#/$defs/canvasSpec" },
        "panels": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/panel" },
          "description": "In-view overlays toggled via skin.togglePanel (drawers, dropdowns)."
        },
        "state": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/viewStateVariable" },
          "description": "Ephemeral in-view variables (menu/content screens, etc.)."
        },
        "onActivate": {
          "type": "array",
          "description": "Effects run once when the skin-mode window becomes visible.",
          "items": { "$ref": "#/$defs/viewActivateEffect" }
        },
        "window": {
          "$ref": "#/$defs/windowChrome",
          "description": "Native window size constraints for this view."
        },
        "layout": { "$ref": "#/$defs/layoutNode" }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultOpen": { "type": "boolean" },
        "windowWhenOpen": { "$ref": "#/$defs/panelWindowOverride" },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "durationMs": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "panelWindowOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "viewStateVariable": {
      "type": "object",
      "required": ["default"],
      "additionalProperties": false,
      "properties": {
        "default": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" }
          ]
        },
        "on": {
          "type": "object",
          "description": "Named state transition events (e.g. toggle) mapped to ordered branch lists.",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/viewStateTransition" }
          }
        }
      }
    },
    "viewStateTransition": {
      "type": "object",
      "required": ["set"],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "array",
          "description": "Current values that allow this branch (omit = any).",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" }
            ]
          }
        },
        "set": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" }
          ],
          "description": "New value for the variable."
        },
        "sound": {
          "type": "string",
          "minLength": 1,
          "description": "Manifest soundEffects key played before set (transition start)."
        }
      }
    },
    "viewActivateEffect": {
      "type": "object",
      "required": ["action"],
      "additionalProperties": false,
      "properties": {
        "when": {
          "$ref": "#/$defs/skinCondition",
          "description": "Condition; effect runs only when truthy (same evaluator as visibleWhen)."
        },
        "delayMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Wait after activate before dispatch (default 0)."
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "description": "Existing skin action id (e.g. view.setVariable)."
        },
        "payload": {
          "type": "object",
          "description": "Merged into action payload."
        },
        "sound": {
          "type": "string",
          "minLength": 1,
          "description": "Manifest soundEffects key played before the action (transition start)."
        }
      }
    },
    "canvasSpec": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "widthWhen": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "heightWhen": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "layoutBounds": {
      "type": "object",
      "required": ["y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "right": {
          "type": "number",
          "description": "WMP right anchor: inset of the node's left edge from the stage right (view.width - N)."
        },
        "y": { "type": "number" },
        "w": { "type": "number", "minimum": 1 },
        "h": { "type": "number", "minimum": 1 },
        "zIndex": { "type": "integer" }
      },
      "anyOf": [{ "required": ["x"] }, { "required": ["right"] }]
    },
    "layoutNode": {
      "oneOf": [
        { "$ref": "#/$defs/containerNode" },
        { "$ref": "#/$defs/subviewNode" },
        { "$ref": "#/$defs/regionNode" },
        { "$ref": "#/$defs/decorationNode" },
        { "$ref": "#/$defs/hitAreaNode" },
        { "$ref": "#/$defs/tiledFrameNode" },
        { "$ref": "#/$defs/controlNode" },
        { "$ref": "#/$defs/buttonGroupNode" },
        { "$ref": "#/$defs/slideshowNode" },
        { "$ref": "#/$defs/scrollStripNode" },
        { "$ref": "#/$defs/eqBandNode" },
        { "$ref": "#/$defs/balanceNode" }
      ]
    },
    "skinCondition": {
      "description": "Boolean composition of skin bind paths (leaf string or all/any/not).",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["all"],
          "additionalProperties": false,
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/skinCondition" }
            }
          }
        },
        {
          "type": "object",
          "required": ["any"],
          "additionalProperties": false,
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/skinCondition" }
            }
          }
        },
        {
          "type": "object",
          "required": ["not"],
          "additionalProperties": false,
          "properties": {
            "not": { "$ref": "#/$defs/skinCondition" }
          }
        }
      ]
    },
    "nodeBase": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "bounds": { "$ref": "#/$defs/layoutBounds" },
        "boundsWhen": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/layoutBoundsPartial" }
        },
        "visibleWhen": { "$ref": "#/$defs/skinCondition" },
        "animations": { "type": "object" }
      }
    },
    "layoutBoundsPartial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "right": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number", "minimum": 1 },
        "h": { "type": "number", "minimum": 1 },
        "zIndex": { "type": "integer" }
      }
    },
    "containerNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["type", "children"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "type": {
              "type": "string",
              "enum": ["stack", "row", "column", "overlay", "canvas"],
              "description": "canvas is valid only as a view layout root; nested groups use subview."
            },
            "bounds": { "$ref": "#/$defs/layoutBounds" },
            "boundsWhen": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/layoutBoundsPartial" }
            },
            "children": {
              "type": "array",
              "items": { "$ref": "#/$defs/layoutNode" }
            },
            "position": { "type": "string", "enum": ["relative", "absolute"] },
            "zIndex": { "type": "integer" },
            "visibleWhen": { "$ref": "#/$defs/skinCondition" },
            "animations": { "type": "object" },
            "dragRegion": {
              "type": "boolean",
              "description": "When true, pointer events on this container move the skin window."
            }
          }
        }
      ]
    },
    "subviewNode": {
      "description": "Bounded nested group (WMS subview). Parent-relative bounds; not valid as a view layout root.",
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["type", "bounds", "children"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "type": { "const": "subview" },
            "bounds": { "$ref": "#/$defs/layoutBounds" },
            "boundsWhen": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/layoutBoundsPartial" }
            },
            "children": {
              "type": "array",
              "items": { "$ref": "#/$defs/layoutNode" }
            },
            "visibleWhen": { "$ref": "#/$defs/skinCondition" },
            "animations": { "type": "object" },
            "passthrough": {
              "type": "boolean",
              "description": "When true, the group bounds box does not capture pointer events (children still do)."
            },
            "dragRegion": {
              "type": "boolean",
              "description": "When true, pointer events on empty group space move the skin window."
            }
          }
        }
      ]
    },
    "regionNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["type", "slot", "children"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "region" },
            "slot": {
              "type": "string",
              "enum": [
                "header",
                "art",
                "info",
                "controls",
                "visualizer",
                "footer"
              ]
            },
            "children": {
              "type": "array",
              "items": { "$ref": "#/$defs/layoutNode" }
            },
            "bounds": { "$ref": "#/$defs/layoutBounds" },
            "dragRegion": {
              "type": "boolean",
              "description": "When true, the region is a window drag handle."
            },
            "visibleWhen": { "$ref": "#/$defs/skinCondition" },
            "animations": { "type": "object" }
          }
        }
      ]
    },
    "decorationNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["type", "presentation"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "decoration" },
            "presentation": { "$ref": "#/$defs/presentation" },
            "bounds": { "$ref": "#/$defs/layoutBounds" },
            "boundsWhen": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/layoutBoundsPartial" }
            },
            "dragRegion": {
              "type": "boolean",
              "description": "When true on a canvas view, marks a window drag handle"
            },
            "visibleWhen": { "$ref": "#/$defs/skinCondition" },
            "animations": { "type": "object" }
          }
        }
      ]
    },
    "hitAreaNode": {
      "description": "Solid canvas hit target without a Tauri drag attribute. Use on click-through skins where bounds must block OS pass-through but stage dragInference handles window moves.",
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["type", "bounds"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "hitArea" },
            "bounds": { "$ref": "#/$defs/layoutBounds" },
            "boundsWhen": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/layoutBoundsPartial" }
            },
            "visibleWhen": { "$ref": "#/$defs/skinCondition" },
            "animations": { "type": "object" }
          }
        }
      ]
    },
    "tiledFrameNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["type", "presentation", "children"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "tiledFrame" },
            "presentation": { "$ref": "#/$defs/tiledFramePresentation" },
            "children": {
              "type": "array",
              "items": { "$ref": "#/$defs/layoutNode" }
            },
            "bounds": { "$ref": "#/$defs/layoutBounds" },
            "visibleWhen": { "$ref": "#/$defs/skinCondition" },
            "animations": { "type": "object" }
          }
        }
      ]
    },
    "tiledFrameTileSize": {
      "type": "object",
      "required": ["w", "h"],
      "additionalProperties": false,
      "properties": {
        "w": { "type": "number", "minimum": 1 },
        "h": { "type": "number", "minimum": 1 },
        "artHeight": { "type": "number", "minimum": 1 }
      }
    },
    "stretchLayoutBounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "right": {
          "type": "number",
          "description": "Inset from stage right; with x and no w, enables horizontal stretch."
        },
        "y": { "type": "number" },
        "bottom": {
          "type": "number",
          "description": "Inset from stage bottom; with y and no h, enables vertical stretch."
        },
        "w": { "type": "number", "minimum": 1 },
        "h": { "type": "number", "minimum": 1 },
        "zIndex": { "type": "integer" }
      }
    },
    "tiledFrameTileDef": {
      "type": "object",
      "required": ["asset", "bounds"],
      "additionalProperties": false,
      "properties": {
        "asset": { "$ref": "#/$defs/skinAssetFile" },
        "bounds": { "$ref": "#/$defs/stretchLayoutBounds" },
        "repeat": { "type": "string", "enum": ["horizontal", "vertical"] },
        "tileUnit": { "$ref": "#/$defs/tiledFrameTileSize" },
        "artHeight": { "type": "number", "minimum": 1 },
        "zIndex": { "type": "integer" }
      }
    },
    "tiledFrameContentInset": {
      "type": "object",
      "required": ["left", "top", "right", "bottom"],
      "additionalProperties": false,
      "properties": {
        "left": { "type": "number", "minimum": 0 },
        "top": { "type": "number", "minimum": 0 },
        "right": { "type": "number", "minimum": 0 },
        "bottom": { "type": "number", "minimum": 0 }
      }
    },
    "tiledFramePresetPresentation": {
      "type": "object",
      "required": [
        "kind",
        "assets",
        "tileSizes",
        "frameThickness",
        "contentInset"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "tiledFrame" },
        "assets": {
          "type": "object",
          "required": [
            "topLeft",
            "topCenter",
            "topRight",
            "topStretch",
            "leftStretch",
            "rightStretch",
            "bottomLeft",
            "bottomCenter",
            "bottomRight",
            "bottomStretch"
          ],
          "additionalProperties": false,
          "properties": {
            "topLeft": { "$ref": "#/$defs/skinAssetFile" },
            "topCenter": { "$ref": "#/$defs/skinAssetFile" },
            "topRight": { "$ref": "#/$defs/skinAssetFile" },
            "topStretch": { "$ref": "#/$defs/skinAssetFile" },
            "topStretch2": { "$ref": "#/$defs/skinAssetFile" },
            "leftStretch": { "$ref": "#/$defs/skinAssetFile" },
            "rightStretch": { "$ref": "#/$defs/skinAssetFile" },
            "bottomLeft": { "$ref": "#/$defs/skinAssetFile" },
            "bottomCenter": { "$ref": "#/$defs/skinAssetFile" },
            "bottomRight": { "$ref": "#/$defs/skinAssetFile" },
            "bottomStretch": { "$ref": "#/$defs/skinAssetFile" },
            "bottomStretch2": { "$ref": "#/$defs/skinAssetFile" },
            "resizeGrip": { "$ref": "#/$defs/skinAssetFile" }
          }
        },
        "tileSizes": {
          "type": "object",
          "required": [
            "topLeft",
            "topCenter",
            "topRight",
            "bottomLeft",
            "bottomCenter",
            "bottomRight"
          ],
          "additionalProperties": false,
          "properties": {
            "topLeft": { "$ref": "#/$defs/tiledFrameTileSize" },
            "topCenter": { "$ref": "#/$defs/tiledFrameTileSize" },
            "topRight": { "$ref": "#/$defs/tiledFrameTileSize" },
            "topStretch": { "$ref": "#/$defs/tiledFrameTileSize" },
            "topStretch2": { "$ref": "#/$defs/tiledFrameTileSize" },
            "leftStretch": { "$ref": "#/$defs/tiledFrameTileSize" },
            "rightStretch": { "$ref": "#/$defs/tiledFrameTileSize" },
            "bottomLeft": { "$ref": "#/$defs/tiledFrameTileSize" },
            "bottomCenter": { "$ref": "#/$defs/tiledFrameTileSize" },
            "bottomRight": { "$ref": "#/$defs/tiledFrameTileSize" },
            "bottomStretch": { "$ref": "#/$defs/tiledFrameTileSize" },
            "bottomStretch2": { "$ref": "#/$defs/tiledFrameTileSize" },
            "resizeGrip": { "$ref": "#/$defs/tiledFrameTileSize" }
          }
        },
        "frameThickness": { "type": "number", "minimum": 1 },
        "contentInset": { "$ref": "#/$defs/tiledFrameContentInset" }
      }
    },
    "tiledFrameExplicitPresentation": {
      "type": "object",
      "required": ["kind", "contentInset", "tiles"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "tiledFrame" },
        "contentInset": { "$ref": "#/$defs/tiledFrameContentInset" },
        "tiles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tiledFrameTileDef" }
        }
      }
    },
    "tiledFramePresentation": {
      "oneOf": [
        { "$ref": "#/$defs/tiledFrameExplicitPresentation" },
        { "$ref": "#/$defs/tiledFramePresetPresentation" }
      ]
    },
    "controlNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["type", "presentation"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "type": {
              "type": "string",
              "enum": [
                "button",
                "seekbar",
                "text",
                "artwork",
                "transport",
                "visualizer",
                "volume",
                "queue",
                "time",
                "playlist"
              ]
            },
            "action": { "type": "string" },
            "panelId": { "type": "string", "minLength": 1 },
            "viewId": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "minLength": 1 },
            "bind": { "type": "string" },
            "value": { "type": "string" },
            "overflow": {
              "type": "string",
              "enum": ["visible", "clip", "scroll", "scroll-bounce"],
              "description": "Runtime overflow behavior. Typography belongs in skin CSS."
            },
            "enabledWhen": {
              "$ref": "#/$defs/skinCondition",
              "description": "When truthy, the control is interactive."
            },
            "activeWhen": {
              "$ref": "#/$defs/skinCondition",
              "description": "When truthy, keep the pressed overlay (WMP sticky buttons)."
            },
            "sound": {
              "type": "string",
              "minLength": 1,
              "description": "Manifest soundEffects key played on click."
            },
            "tooltip": {
              "type": "string",
              "description": "OS tooltip text; supports {bind.path} placeholders."
            },
            "tooltipWhen": {
              "type": "object",
              "description": "Bind path → tooltip when truthy (last match wins).",
              "additionalProperties": { "type": "string" }
            },
            "payload": {
              "type": "object",
              "description": "Extra action payload merged at dispatch.",
              "additionalProperties": true
            },
            "presentation": { "$ref": "#/$defs/presentation" },
            "bounds": { "$ref": "#/$defs/layoutBounds" },
            "boundsWhen": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/layoutBoundsPartial" }
            },
            "visibleWhen": { "$ref": "#/$defs/skinCondition" },
            "animations": { "type": "object" }
          }
        }
      ]
    },
    "buttonGroupNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["type", "presentation"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "buttonGroup" },
            "presentation": { "$ref": "#/$defs/buttonGroupPresentation" },
            "bounds": { "$ref": "#/$defs/layoutBounds" },
            "visibleWhen": { "$ref": "#/$defs/skinCondition" },
            "animations": { "type": "object" }
          }
        }
      ]
    },
    "slideshowNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["type", "presentation"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "type": { "const": "slideshow" },
            "presentation": { "$ref": "#/$defs/slideshowPresentation" },
            "bounds": { "$ref": "#/$defs/layoutBounds" },
            "visibleWhen": { "$ref": "#/$defs/skinCondition" },
            "animations": { "type": "object" }
          }
        }
      ]
    },
    "slideshowPresentation": {
      "type": "object",
      "required": ["kind", "assetPattern", "decks"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "imageSequence" },
        "assetPattern": {
          "type": "string",
          "minLength": 1,
          "description": "Asset path template under assets/ with extension; {deckIndex} and {page} placeholders."
        },
        "decks": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/slideshowDeck" }
        }
      }
    },
    "slideshowDeck": {
      "type": "object",
      "required": ["deckIndex", "pages"],
      "additionalProperties": false,
      "properties": {
        "deckIndex": { "type": "integer", "minimum": 1 },
        "pages": { "type": "integer", "minimum": 1 },
        "showPageNav": {
          "type": "boolean",
          "description": "When false, prev/next chrome is hidden (WMP trailer deck). Default true."
        }
      }
    },
    "scrollStripNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["type", "id", "presentation", "bounds"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "type": { "const": "scrollStrip" },
            "presentation": { "$ref": "#/$defs/scrollStripPresentation" },
            "bounds": { "$ref": "#/$defs/layoutBounds" },
            "visibleWhen": { "$ref": "#/$defs/skinCondition" },
            "animations": { "type": "object" }
          }
        }
      ]
    },
    "scrollStripPresentation": {
      "type": "object",
      "required": ["kind", "items", "slides"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "bitmapVertical" },
        "transitionMs": { "type": "integer", "minimum": 0 },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scrollStripItem" }
        },
        "slides": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scrollStripSlide" }
        }
      }
    },
    "scrollStripItem": {
      "type": "object",
      "required": ["id", "asset", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "asset": { "type": "string", "minLength": 1 },
        "w": { "type": "number", "minimum": 1 },
        "h": { "type": "number", "minimum": 1 }
      }
    },
    "scrollStripSlide": {
      "type": "object",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["y"],
            "additionalProperties": false,
            "properties": {
              "y": { "type": "number" }
            }
          }
        }
      }
    },
    "eqBandNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["type", "band", "presentation"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "eqBand" },
            "band": { "type": "integer", "minimum": 1, "maximum": 10 },
            "action": { "type": "string" },
            "panelId": { "type": "string", "minLength": 1 },
            "viewId": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "minLength": 1 },
            "bind": { "type": "string" },
            "enabledWhen": { "$ref": "#/$defs/skinCondition" },
            "tooltip": {
              "type": "string",
              "description": "OS tooltip text; supports {bind.path} placeholders."
            },
            "tooltipWhen": {
              "type": "object",
              "description": "Bind path → tooltip when truthy (last match wins).",
              "additionalProperties": { "type": "string" }
            },
            "presentation": {
              "oneOf": [
                { "$ref": "#/$defs/stripSliderPresentation" },
                { "$ref": "#/$defs/bitmapVerticalSliderPresentation" }
              ]
            },
            "bounds": { "$ref": "#/$defs/layoutBounds" },
            "visibleWhen": { "$ref": "#/$defs/skinCondition" },
            "animations": { "type": "object" }
          }
        }
      ]
    },
    "balanceNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["type", "presentation"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "balance" },
            "action": { "type": "string" },
            "panelId": { "type": "string", "minLength": 1 },
            "viewId": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "minLength": 1 },
            "bind": { "type": "string" },
            "enabledWhen": { "$ref": "#/$defs/skinCondition" },
            "tooltip": {
              "type": "string",
              "description": "OS tooltip text; supports {bind.path} placeholders."
            },
            "tooltipWhen": {
              "type": "object",
              "description": "Bind path → tooltip when truthy (last match wins).",
              "additionalProperties": { "type": "string" }
            },
            "presentation": {
              "oneOf": [
                { "$ref": "#/$defs/bitmapHorizontalSliderPresentation" }
              ]
            },
            "bounds": { "$ref": "#/$defs/layoutBounds" },
            "visibleWhen": { "$ref": "#/$defs/skinCondition" },
            "animations": { "type": "object" }
          }
        }
      ]
    },
    "presentation": {
      "oneOf": [
        { "$ref": "#/$defs/bitmapPresentation" },
        { "$ref": "#/$defs/buttonGroupPresentation" },
        { "$ref": "#/$defs/gifPresentation" },
        { "$ref": "#/$defs/primitivePresentation" },
        { "$ref": "#/$defs/cssPresentation" },
        { "$ref": "#/$defs/stripSliderPresentation" },
        { "$ref": "#/$defs/bitmapVerticalSliderPresentation" },
        { "$ref": "#/$defs/bitmapHorizontalSliderPresentation" },
        { "$ref": "#/$defs/bitmapSeekbarPresentation" },
        { "$ref": "#/$defs/digitStripPresentation" },
        { "$ref": "#/$defs/framedPanelPresentation" },
        { "$ref": "#/$defs/compactPlaylistPresentation" }
      ]
    },
    "bitmapPresentation": {
      "type": "object",
      "required": ["kind", "assets"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "bitmap" },
        "assets": { "$ref": "#/$defs/interactiveAssets" },
        "assetsWhen": { "$ref": "#/$defs/interactiveAssetsWhen" },
        "width": { "type": "number", "minimum": 1 },
        "height": { "type": "number", "minimum": 1 }
      }
    },
    "buttonGroupPresentation": {
      "type": "object",
      "required": ["kind", "assets", "positionMap", "elements"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "buttonGroup" },
        "assets": { "$ref": "#/$defs/interactiveAssets" },
        "assetsWhen": { "$ref": "#/$defs/interactiveAssetsWhen" },
        "positionMap": { "$ref": "#/$defs/skinAssetFile" },
        "width": { "type": "number", "minimum": 1 },
        "height": { "type": "number", "minimum": 1 },
        "sound": {
          "type": "string",
          "minLength": 1,
          "description": "Manifest soundEffects key played on any element click in this group."
        },
        "elevateWhen": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Sibling buttonGroup node ids. When any listed group is hovered or pressed, this group co-elevates above it so overlay artwork stays visible on overlapping composite sheets."
        },
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["mappingColor", "action"],
            "additionalProperties": false,
            "properties": {
              "mappingColor": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "action": { "type": "string" },
              "panelId": { "type": "string", "minLength": 1 },
              "viewId": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "minLength": 1 },
              "activeWhen": {
                "$ref": "#/$defs/skinCondition",
                "description": "When truthy, keep the pressed overlay (WMP sticky buttons)."
              },
              "enabledWhen": {
                "$ref": "#/$defs/skinCondition",
                "description": "When truthy, the element is interactive."
              },
              "sound": {
                "type": "string",
                "minLength": 1,
                "description": "Manifest soundEffects key; overrides group-level sound."
              },
              "tooltip": {
                "type": "string",
                "description": "OS tooltip text; supports {bind.path} placeholders."
              },
              "tooltipWhen": {
                "type": "object",
                "description": "Bind path → tooltip when truthy (last match wins).",
                "additionalProperties": { "type": "string" }
              },
              "payload": {
                "type": "object",
                "description": "Extra action payload merged at dispatch.",
                "additionalProperties": true
              }
            }
          }
        }
      }
    },
    "gifPresentation": {
      "type": "object",
      "required": ["kind", "asset"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "gif" },
        "asset": { "$ref": "#/$defs/skinAssetFile" },
        "durationMs": {
          "type": "integer",
          "minimum": 1,
          "description": "Target loop duration in ms; scales frame timing to match. With completeAction, fires after one scaled loop."
        },
        "playbackRate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Multiplier on native frame delays (1 = file timing, 0.5 = half speed). Ignored when durationMs is set."
        },
        "completeAction": {
          "type": "string",
          "description": "Action dispatched after the first scaled animation loop completes."
        },
        "completePayload": {
          "type": "object",
          "description": "Payload merged when completeAction fires (e.g. view.setVariable)."
        }
      }
    },
    "primitivePresentation": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "primitive" },
        "classPrefix": { "type": "string" },
        "variant": { "type": "string" }
      }
    },
    "cssPresentation": {
      "type": "object",
      "required": ["kind", "className"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "css" },
        "className": { "type": "string" },
        "stylesheet": { "type": "string" }
      }
    },
    "stripSliderPresentation": {
      "type": "object",
      "required": ["kind", "strip", "frameWidth", "frameCount"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "stripSlider" },
        "strip": { "$ref": "#/$defs/skinAssetFile" },
        "positionMap": { "$ref": "#/$defs/skinAssetFile" },
        "frameWidth": { "type": "number", "minimum": 1 },
        "frameHeight": { "type": "number", "minimum": 1 },
        "frameCount": { "type": "number", "minimum": 2 },
        "direction": {
          "type": "string",
          "enum": ["horizontal", "vertical"],
          "description": "Fallback drag axis when positionMap is absent"
        },
        "valueFrames": {
          "type": "string",
          "enum": ["ascending", "descending"],
          "description": "How normalized value maps to strip frame indices. ascending (default): frame 0 = min value. descending: frame 0 = max value."
        },
        "mapFrames": {
          "type": "string",
          "enum": ["ascending", "descending"],
          "description": "How position-map colors map to frame indices along the interaction axis. ascending (default): horizontal left / vertical bottom = frame 0."
        },
        "classPrefix": { "type": "string" }
      }
    },
    "bitmapVerticalSliderPresentation": {
      "type": "object",
      "required": [
        "kind",
        "thumb",
        "trackWidth",
        "trackHeight",
        "thumbWidth",
        "thumbHeight"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "bitmapVerticalSlider" },
        "track": {
          "$ref": "#/$defs/skinAssetFile",
          "description": "Omitted for thumb-only sliders (groove baked into panel background)."
        },
        "thumb": { "$ref": "#/$defs/skinAssetFile" },
        "thumbPressed": {
          "$ref": "#/$defs/skinAssetFile",
          "description": "WMP thumbDownImage; shown while dragging."
        },
        "trackTileWidth": {
          "type": "number",
          "minimum": 1,
          "description": "Source tile width in px; required when track is set."
        },
        "trackTileHeight": {
          "type": "number",
          "minimum": 1,
          "description": "Source tile height in px; when less than trackHeight, 3-slice tiling repeats the middle."
        },
        "trackWidth": { "type": "number", "minimum": 1 },
        "trackHeight": { "type": "number", "minimum": 1 },
        "thumbWidth": { "type": "number", "minimum": 1 },
        "thumbHeight": { "type": "number", "minimum": 1 },
        "borderSize": {
          "type": "number",
          "minimum": 0,
          "description": "Cap size and thumb travel inset (WMP borderSize); enables 3-slice tiling when > 0"
        },
        "fillFromBottom": {
          "type": "boolean",
          "description": "When true, the track image is a bottom-anchored value fill (WMP foregroundImage) revealed up to the current value; the empty groove is expected in the window background."
        },
        "classPrefix": { "type": "string" }
      }
    },
    "bitmapHorizontalSliderPresentation": {
      "type": "object",
      "required": [
        "kind",
        "track",
        "thumb",
        "trackTileWidth",
        "trackTileHeight",
        "trackWidth",
        "trackHeight",
        "thumbWidth",
        "thumbHeight"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "bitmapHorizontalSlider" },
        "track": { "$ref": "#/$defs/skinAssetFile" },
        "thumb": { "$ref": "#/$defs/skinAssetFile" },
        "trackTileWidth": {
          "type": "number",
          "minimum": 1,
          "description": "Source tile width in px; when less than trackWidth, 3-slice tiling repeats the middle"
        },
        "trackTileHeight": {
          "type": "number",
          "minimum": 1,
          "description": "Source tile height in px"
        },
        "trackWidth": { "type": "number", "minimum": 1 },
        "trackHeight": { "type": "number", "minimum": 1 },
        "thumbWidth": { "type": "number", "minimum": 1 },
        "thumbHeight": { "type": "number", "minimum": 1 },
        "borderSize": {
          "type": "number",
          "minimum": 0,
          "description": "Cap size and thumb travel inset (WMP borderSize); enables 3-slice tiling when > 0"
        },
        "classPrefix": { "type": "string" }
      }
    },
    "bitmapSeekbarPresentation": {
      "type": "object",
      "required": [
        "kind",
        "track",
        "fill",
        "thumbAssets",
        "borderSize",
        "trackWidth",
        "trackHeight",
        "thumbWidth",
        "thumbHeight"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "bitmapSeekbar" },
        "track": { "$ref": "#/$defs/skinAssetFile" },
        "fill": { "$ref": "#/$defs/skinAssetFile" },
        "thumbAssets": { "$ref": "#/$defs/interactiveAssets" },
        "borderSize": {
          "type": "number",
          "minimum": 0,
          "description": "Inset from each track edge for thumb travel (WMP borderSize)"
        },
        "trackWidth": { "type": "number", "minimum": 1 },
        "trackHeight": { "type": "number", "minimum": 1 },
        "thumbWidth": { "type": "number", "minimum": 1 },
        "thumbHeight": { "type": "number", "minimum": 1 },
        "classPrefix": { "type": "string" }
      }
    },
    "digitStripPresentation": {
      "type": "object",
      "required": ["kind", "strip", "frameWidth", "frameHeight", "slots"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "digitStrip" },
        "strip": { "$ref": "#/$defs/skinAssetFile" },
        "frameWidth": { "type": "number", "minimum": 1 },
        "frameHeight": { "type": "number", "minimum": 1 },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/digitStripSlot" }
        },
        "signFrameElapsed": {
          "type": "integer",
          "minimum": 0,
          "description": "Strip frame for elapsed separator (WMP default 10)"
        },
        "signFrameRemaining": {
          "type": "integer",
          "minimum": 0,
          "description": "Strip frame for remaining prefix (WMP default 11)"
        },
        "classPrefix": { "type": "string" }
      }
    },
    "framedPanelPresentation": {
      "type": "object",
      "required": ["kind", "mask"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "framedPanel" },
        "mask": { "$ref": "#/$defs/skinAssetFile" },
        "frame": { "$ref": "#/$defs/skinAssetFile" },
        "contentInset": { "$ref": "#/$defs/framedPanelInset" },
        "classPrefix": { "type": "string" }
      }
    },
    "compactPlaylistPresentation": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "compact" },
        "showDropdown": {
          "type": "boolean",
          "description": "Show source dropdown (All tracks, Up Next, user playlists). Default true."
        },
        "showDuration": {
          "type": "boolean",
          "description": "Show track duration column. Default true."
        }
      }
    },
    "framedPanelInset": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "w": { "type": "number", "minimum": 1 },
        "h": { "type": "number", "minimum": 1 }
      }
    },
    "digitStripSlot": {
      "type": "object",
      "required": ["role", "x"],
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "sign",
            "minuteTens",
            "minuteOnes",
            "secondTens",
            "secondOnes"
          ]
        },
        "x": { "type": "number", "minimum": 0 }
      }
    },
    "visualizerSize": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "oneOf": [
            { "type": "string", "const": "fill" },
            { "type": "integer", "minimum": 1 }
          ],
          "description": "fill = 100% of slot width; integer = fixed px"
        },
        "height": {
          "oneOf": [
            { "type": "string", "enum": ["flex", "fill"] },
            { "type": "integer", "minimum": 1 }
          ],
          "description": "flex = grow in shell; fill = 100% of slot; integer = fixed px"
        },
        "minHeight": { "type": "integer", "minimum": 1 },
        "maxHeight": { "type": "integer", "minimum": 1 }
      }
    },
    "windowChrome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clipMask": { "type": "string" },
        "defaultWidth": { "type": "integer", "minimum": 200 },
        "defaultHeight": { "type": "integer", "minimum": 200 },
        "minWidth": { "type": "integer", "minimum": 160 },
        "minHeight": { "type": "integer", "minimum": 160 },
        "maxWidth": { "type": "integer", "minimum": 200 },
        "maxHeight": { "type": "integer", "minimum": 200 },
        "resizable": { "type": "boolean" },
        "snapEnabled": { "type": "boolean" }
      }
    }
  }
}
