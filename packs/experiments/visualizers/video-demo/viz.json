{
  "$schema": "../../../../../schemas/viz-v1.schema.json",
  "id": "video-demo",
  "name": "Video Demo",
  "author": "Spiral",
  "description": "Full-viewport looping video background.",
  "surfaces": {
    "default": {
      "scene": [
        {
          "id": "bg",
          "kind": "video",
          "asset": "assets/ambient-swim-clip-PLACEHOLDER.webm",
          "layout": "fill",
          "loop": true,
          "opacity": 0.9
        },
        {
          "id": "wave",
          "kind": "canvas",
          "renderer": "spiral.core.renderer.wave",
          "layout": {
            "x": 0,
            "y": 0.58,
            "w": 1,
            "h": 0.42
          },
          "params": {
            "mirror": true,
            "glow": 0.8,
            "barCount": 72
          }
        }
      ]
    }
  }
}
