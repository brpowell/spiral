{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiral.dev/schemas/viz-v1.json",
  "title": "Spiral visualizer pack manifest v1",
  "type": "object",
  "required": ["version", "name", "author", "description", "surfaces"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference",
      "description": "JSON Schema reference for editor validation."
    },
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "author": { "type": "string" },
    "description": { "type": "string" },
    "preview": {
      "type": "string",
      "description": "Preview image path relative to pack root (e.g. preview.png)."
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default"],
      "description": "Surface profiles. default is required; mini, panel, and expanded override it when present.",
      "properties": {
        "default": { "$ref": "#/$defs/surfaceProfile" },
        "mini": { "$ref": "#/$defs/surfaceProfile" },
        "panel": { "$ref": "#/$defs/surfaceProfile" },
        "expanded": { "$ref": "#/$defs/surfaceProfile" }
      }
    },
    "reducedSurfaces": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional reduced-motion overrides. Surfaces without an entry fall back to default, then to the matching surfaces entry.",
      "properties": {
        "default": { "$ref": "#/$defs/surfaceProfile" },
        "mini": { "$ref": "#/$defs/surfaceProfile" },
        "panel": { "$ref": "#/$defs/surfaceProfile" },
        "expanded": { "$ref": "#/$defs/surfaceProfile" }
      }
    }
  },
  "$defs": {
    "surfaceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene"],
      "properties": {
        "scene": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sceneLayer" }
        }
      }
    },
    "rendererParams": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "barCount": { "type": "integer", "minimum": 1, "maximum": 256 },
        "mirror": { "type": "boolean" },
        "glow": { "type": "number", "minimum": 0, "maximum": 2 },
        "orientation": {
          "type": "string",
          "enum": ["horizontal", "vertical"]
        }
      }
    },
    "webglRendererParams": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "ringCount": { "type": "integer", "minimum": 12, "maximum": 64 },
        "tunnelSpeed": { "type": "number", "minimum": 0.2, "maximum": 3 },
        "glow": { "type": "number", "minimum": 0, "maximum": 2 },
        "particleDensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "bassPulse": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "sceneLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "layout"],
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["canvas", "webgl", "image", "gif", "video", "group"]
        },
        "layout": { "$ref": "#/$defs/sceneLayout" },
        "layoutParams": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "visibleWhen": {
          "$ref": "https://spiral.dev/schemas/presentation-common.json#/$defs/bindExpression"
        },
        "blend": { "type": "string" },
        "drive": {
          "type": "object",
          "additionalProperties": {
            "$ref": "https://spiral.dev/schemas/presentation-common.json#/$defs/driveBinding"
          }
        },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "scale": { "type": "number", "minimum": 0 },
        "translateX": { "type": "number" },
        "translateY": { "type": "number" },
        "rotation": { "type": "number" },
        "renderer": {
          "type": "string",
          "enum": ["bars", "wave", "spectrum", "neon-tunnel"]
        },
        "params": {
          "oneOf": [
            { "$ref": "#/$defs/rendererParams" },
            { "$ref": "#/$defs/webglRendererParams" }
          ]
        },
        "asset": {
          "$ref": "https://spiral.dev/schemas/presentation-common.json#/$defs/assetRef"
        },
        "loop": { "type": "boolean" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/sceneLayer" }
        }
      }
    },
    "sceneLayout": {
      "oneOf": [
        { "const": "fill" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "w", "h"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 },
            "w": { "type": "number", "minimum": 0, "maximum": 1 },
            "h": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["anchor", "w", "h"],
          "properties": {
            "anchor": {
              "type": "string",
              "enum": ["center", "top", "bottom", "left", "right"]
            },
            "w": { "type": "number", "minimum": 0, "maximum": 1 },
            "h": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      ]
    }
  }
}
