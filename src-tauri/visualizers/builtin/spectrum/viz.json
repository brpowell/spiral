          "renderer": "spectrum",
          "params": { "barCount": 96, "mirror": false, "glow": 0.7 }
        }
      ]
    },
    "mini": {
      "scene": [
        {
          "id": "spectrum",
          "kind": "canvas",
          "layout": "fill",
          "renderer": "spectrum",
          "params": { "barCount": 48, "mirror": false, "glow": 0.5 }
        }
      ]
    },
    "expanded": {
      "scene": [
        {
          "id": "spectrum",
          "kind": "canvas",
          "layout": "fill",
          "renderer": "spectrum",
          "params": { "barCount": 128, "mirror": true, "glow": 0.9 }
        }
      ]
    }
  }
}
