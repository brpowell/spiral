{
  "$schema": "../../schema/viz-v1.schema.json",
  "version": 1,
  "name": "Spectrum",
  "author": "Spiral",
  "description": "Log-filled frequency spectrum with album palette accents.",
  "surfaces": {
    "default": {
      "scene": [
        {
          "id": "spectrum",
