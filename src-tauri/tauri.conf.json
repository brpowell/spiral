{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spiral",
  "version": "1.0.0",
  "identifier": "com.spiralpowered.music",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Spiral",
        "width": 1200,
        "height": 800,
        "backgroundThrottling": "disabled"
      },
      {
        "label": "skin-mode",
        "title": "Spiral Skin Mode",
        "width": 320,
        "height": 440,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "resizable": true,
        "minWidth": 200,
        "minHeight": 120,
        "dragDropEnabled": false,
        "acceptFirstMouse": true
      },
      {
        "label": "skin-picker",
        "title": "Skins",
        "width": 600,
        "height": 600,
        "visible": false,
        "resizable": true,
        "minWidth": 400,
        "minHeight": 420,
        "dragDropEnabled": false
      },
      {
        "label": "activity-logs",
        "title": "Activity Logs",
        "width": 720,
        "height": 520,
        "visible": false,
        "resizable": true,
        "minWidth": 480,
        "minHeight": 320,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**/*",
          "$APPLOCALDATA/**/*",
          "$APPDATA/**/*",
          "$MUSIC/**/*",
          "$AUDIO/**/*",
          "$DOWNLOAD/**/*",
          "$DESKTOP/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "skins/builtin/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
