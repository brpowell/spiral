{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spiral",
  "version": "0.2.1",
  "identifier": "com.spiralpowered.music",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Spiral",
        "width": 1200,
        "height": 800,
        "minWidth": 520,
        "minHeight": 420,
        "backgroundThrottling": "disabled"
      },
      {
        "label": "skin-mode",
        "title": "Spiral Skin Mode",
        "width": 320,
        "height": 440,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "resizable": true,
        "minWidth": 200,
        "minHeight": 120,
        "dragDropEnabled": false,
        "acceptFirstMouse": true
      },
      {
        "label": "appearance",
        "title": "Studio",
        "width": 1000,
        "height": 720,
        "visible": false,
        "resizable": true,
        "minWidth": 520,
        "minHeight": 420,
        "dragDropEnabled": false
      },
      {
        "label": "equalizer",
        "title": "Equalizer",
        "width": 580,
        "height": 260,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minWidth": 580,
        "minHeight": 260,
        "maxWidth": 580,
        "maxHeight": 260,
        "dragDropEnabled": false
      },
      {
        "label": "activity-logs",
        "title": "Activity Logs",
        "width": 720,
        "height": 520,
        "visible": false,
        "resizable": true,
        "minWidth": 480,
        "minHeight": 320,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost blob: data:",
        "media-src": "'self' asset: http://asset.localhost https://asset.localhost blob:",
        "font-src": "'self' data: asset: http://asset.localhost https://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost asset: http://asset.localhost https://asset.localhost",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:1420 http://127.0.0.1:1420",
        "script-src": "'self' 'unsafe-eval' 'unsafe-inline' blob: http://localhost:1420 http://127.0.0.1:1420",
        "style-src": "'self' 'unsafe-inline' http://localhost:1420 http://127.0.0.1:1420",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost blob: data: http://localhost:1420 http://127.0.0.1:1420",
        "media-src": "'self' asset: http://asset.localhost https://asset.localhost blob:",
        "font-src": "'self' data: asset: http://asset.localhost https://asset.localhost http://localhost:1420 http://127.0.0.1:1420",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost asset: http://asset.localhost https://asset.localhost http://localhost:1420 http://127.0.0.1:1420 ws://localhost:1420 ws://localhost:1421 ws://127.0.0.1:1420 ws://127.0.0.1:1421",
        "worker-src": "'self' blob: http://localhost:1420 http://127.0.0.1:1420",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**/*",
          "$APPLOCALDATA/**/*",
          "$APPDATA/**/*",
          "$RESOURCE/**/*",
          "$MUSIC/**/*",
          "$AUDIO/**/*",
          "$DOWNLOAD/**/*",
          "$DESKTOP/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis",
      "app",
      "dmg"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": [
      "packs/builtin/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "spcard"
        ],
        "name": "Spiral Card",
        "description": "Spiral registration card",
        "mimeType": "application/vnd.spiral.spcard+json",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "com.spiralpowered.music.spcard",
          "conformsTo": [
            "public.json",
            "public.data"
          ]
        }
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5QURBREY1NkZFNDEwQ0EKUldUS0VPUnY5YTJ0bVdkS01HdGNjbVFrb0hWYVJkVHU2OWxGcDc5WEVuTWl2N1RhSUlSdjYrZXcK",
      "endpoints": [
        "https://spiralpowered.com/api/updates/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
