{
  "$schema": "../schema/theme-v1.schema.json",
  "id": "noir",
  "name": "Noir",
  "author": "Spiral",
  "description": "True black, stark white, red accent. Cinematic high contrast.",
  "tokens": {
    "color-bg": "#000000",
    "color-surface": "#0a0a0a",
    "color-surface-raised": "#141414",
    "color-text-primary": "#ffffff",
    "color-text-secondary": "#a0a0a0",
    "color-accent": "#e63946",
    "color-accent-muted": "#5c1a22",
    "color-link": "#e63946",
    "color-border": "#2a2a2a",
    "color-danger": "#ff4d4d",
    "color-danger-bg": "#1a0808",
    "color-alert-info": "#a0a0ff",
    "color-alert-info-bg": "#0a0a1a",
    "color-alert-info-border": "#2a2a5a",
    "color-alert-success": "#4dff88",
    "color-alert-success-bg": "#081a0a",
    "color-alert-success-border": "#1a5c2a",
    "color-alert-warning": "#ffcc44",
    "color-alert-warning-bg": "#1a1408",
    "color-alert-warning-border": "#5c4a1a",
    "color-alert-error": "#ff4d4d",
    "color-alert-error-bg": "#1a0808",
    "color-alert-error-border": "#5c1a1a",
    "radius-card": "4px",
    "radius-button": "2px",
    "font-ui": "'Helvetica Neue', Helvetica, Arial, sans-serif"
  }
}
