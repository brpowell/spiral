{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiral.dev/schemas/skin-v1.json",
  "title": "Spiral skin mode manifest v1",
  "type": "object",
  "required": [
    "version",
    "name",
    "author",
    "description",
    "defaultView",
    "views"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference",
      "description": "JSON Schema reference for editor validation."
    },
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "author": { "type": "string" },
    "description": { "type": "string" },
    "defaultView": { "type": "string", "minLength": 1 },
    "views": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/view" }
    },
    "visualizer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pack": {
          "type": "string",
          "minLength": 1,
          "description": "Visualizer pack id, or \"global\" to follow the user's active visualizer picker. Omit pack to use global."
        },
        "preset": {
          "type": "string",
          "enum": ["bars", "wave", "spectrum"],
          "description": "Deprecated — use pack. Maps to built-in pack ids at runtime."
        },
        "placement": {
          "type": "string",
          "enum": ["top", "bottom"],
          "description": "Where the visualizer band sits in the skin shell."
        },
        "display": {
          "type": "string",
          "enum": ["mini", "panel"],
          "description": "mini = compact strip; panel = fills the visualizer slot."
        },
        "size": { "$ref": "#/$defs/visualizerSize" }
      }
    },
    "animations": {
      "type": "object",
      "description": "Reserved for declarative timelines (#17)."
    },
    "timelines": {
      "type": "object",
      "description": "Reserved for declarative timelines (#17)."
    },
    "stylesheet": {
      "type": "string",
      "description": "Optional CSS file path relative to the skin pack root (e.g. skin.css). The runtime auto-prefixes every selector with [data-skin-id] for sandboxing — authors write plain selectors."
    },
    "soundEffects": {
      "type": "object",
      "description": "Optional UI sound assets keyed by logical id (paths under assets/ without extension; .wav on disk).",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "view": {
      "type": "object",
      "required": ["layout"],
      "additionalProperties": false,
      "properties": {
        "presentation": {
          "type": "string",
          "enum": ["primary", "exclusive", "auxiliary"],
          "description": "How the runtime manages the native window for this view."
        },
        "layoutMode": {
          "type": "string",
          "enum": ["slots", "canvas"],
          "default": "slots",
          "description": "slots = SkinShell regions (default); canvas = absolute bounds. Canvas views default to dragInference auto."
        },
        "dragInference": {
          "type": "string",
          "enum": ["auto", "manual"],
          "description": "Window drag inference. Runtime default: auto when layoutMode is canvas, manual for slots. Override per view or via window.dragInference."
        },
        "canvas": { "$ref": "#/$defs/canvasSpec" },
        "panels": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/panel" },
          "description": "In-view overlays toggled via skin.togglePanel (drawers, dropdowns)."
        },
        "state": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/viewStateVariable" },
          "description": "Ephemeral in-view variables (menu/content screens, etc.)."
        },
        "onActivate": {
          "type": "array",
          "description": "Effects run once when the skin-mode window becomes visible.",
          "items": { "$ref": "#/$defs/viewActivateEffect" }
        },
        "window": {
          "$ref": "#/$defs/windowChrome",
          "description": "Native window size constraints for this view."
        },
        "layout": { "$ref": "#/$defs/layoutNode" }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultOpen": { "type": "boolean" },
        "windowWhenOpen": { "$ref": "#/$defs/panelWindowOverride" },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "durationMs": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "panelWindowOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "viewStateVariable": {
      "type": "object",
      "required": ["default"],
      "additionalProperties": false,
      "properties": {
        "default": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" }
          ]
        },
        "on": {
          "type": "object",
          "description": "Named state transition events (e.g. toggle) mapped to ordered branch lists.",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/viewStateTransition" }
          }
        }
      }
    },
    "viewStateTransition": {
      "type": "object",
      "required": ["set"],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "array",
          "description": "Current values that allow this branch (omit = any).",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" }
            ]
          }
        },
        "set": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" }
          ],
          "description": "New value for the variable."
        },
        "sound": {
          "type": "string",
          "minLength": 1,
          "description": "Manifest soundEffects key played before set (transition start)."
        }
      }
    },
    "viewActivateEffect": {
      "type": "object",
      "required": ["action"],
      "additionalProperties": false,
      "properties": {
        "when": {
          "type": "string",
          "description": "Bind path; effect runs only if truthy (same evaluator as visibleWhen)."
        },
        "delayMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Wait after activate before dispatch (default 0)."
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "description": "Existing skin action id (e.g. view.setVariable)."
        },
        "payload": {
          "type": "object",
          "description": "Merged into action payload."
        },
        "sound": {
          "type": "string",
          "minLength": 1,
          "description": "Manifest soundEffects key played before the action (transition start)."
        }
      }
    },
    "canvasSpec": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "widthWhen": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "heightWhen": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "layoutBounds": {
      "type": "object",
      "required": ["y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "right": {
          "type": "number",
          "description": "WMP right anchor: inset of the node's left edge from the stage right (view.width - N)."
        },
        "y": { "type": "number" },
        "w": { "type": "number", "minimum": 1 },
        "h": { "type": "number", "minimum": 1 },
        "zIndex": { "type": "integer" }
      },
      "anyOf": [{ "required": ["x"] }, { "required": ["right"] }]
    },
    "layoutNode": {
      "oneOf": [
        { "$ref": "#/$defs/containerNode" },
        { "$ref": "#/$defs/regionNode" },
        { "$ref": "#/$defs/decorationNode" },
        { "$ref": "#/$defs/hitAreaNode" },
        { "$ref": "#/$defs/tiledFrameNode" },
        { "$ref": "#/$defs/controlNode" },
        { "$ref": "#/$defs/buttonGroupNode" },
        { "$ref": "#/$defs/slideshowNode" },
        { "$ref": "#/$defs/eqBandNode" },
        { "$ref": "#/$defs/balanceNode" }
      ]
    },
    "nodeBase": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "bounds": { "$ref": "#/$defs/layoutBounds" },
        "boundsWhen": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/layoutBoundsPartial" }
        },
        "visibleWhen": { "type": "string" },
        "animations": { "type": "object" }
      }
    },
    "layoutBoundsPartial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "right": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number", "minimum": 1 },
        "h": { "type": "number", "minimum": 1 },
        "zIndex": { "type": "integer" }
      }
    },
    "containerNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["type", "children"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "type": {
              "type": "string",
              "enum": ["stack", "row", "column", "overlay", "canvas"]
            },
            "bounds": { "$ref": "#/$defs/layoutBounds" },
            "boundsWhen": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/layoutBoundsPartial" }
            },
            "children": {
              "type": "array",
              "items": { "$ref": "#/$defs/layoutNode" }
            },
            "position": { "type": "string", "enum": ["relative", "absolute"] },
            "zIndex": { "type": "integer" },
            "visibleWhen": { "type": "string" },
            "animations": { "type": "object" },
            "dragRegion": {
              "type": "boolean",
              "description": "When true, pointer events on this container move the skin window."
            }
          }
        }
      ]
    },
    "regionNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["type", "slot", "children"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "region" },
            "slot": {
              "type": "string",
              "enum": [
                "header",
                "art",
                "info",
                "controls",
                "visualizer",
                "footer"
              ]
            },
            "children": {
              "type": "array",
              "items": { "$ref": "#/$defs/layoutNode" }
            },
            "bounds": { "$ref": "#/$defs/layoutBounds" },
            "dragRegion": {
              "type": "boolean",
              "description": "When true, the region is a window drag handle."
            },
            "visibleWhen": { "type": "string" },
            "animations": { "type": "object" }
          }
        }
      ]
    },
    "decorationNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["type", "presentation"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "decoration" },
            "presentation": { "$ref": "#/$defs/presentation" },
            "bounds": { "$ref": "#/$defs/layoutBounds" },
            "boundsWhen": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/layoutBoundsPartial" }
            },
            "dragRegion": {
              "type": "boolean",
              "description": "When true on a canvas view, marks a window drag handle"
            },
            "visibleWhen": { "type": "string" },
            "animations": { "type": "object" }
          }
        }
      ]
    },
    "hitAreaNode": {
      "description": "Solid canvas hit target without a Tauri drag attribute. Use on click-through skins where bounds must block OS pass-through but stage dragInference handles window moves.",
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["type", "bounds"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "hitArea" },
            "bounds": { "$ref": "#/$defs/layoutBounds" },
            "boundsWhen": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/layoutBoundsPartial" }
            },
            "visibleWhen": { "type": "string" },
            "animations": { "type": "object" }
          }
        }
      ]
    },
    "tiledFrameNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["type", "presentation", "children"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "tiledFrame" },
            "presentation": { "$ref": "#/$defs/tiledFramePresentation" },
            "children": {
              "type": "array",
              "items": { "$ref": "#/$defs/layoutNode" }
            },
            "bounds": { "$ref": "#/$defs/layoutBounds" },
            "visibleWhen": { "type": "string" },
            "animations": { "type": "object" }
          }
        }
      ]
    },
    "tiledFrameTileSize": {
      "type": "object",
      "required": ["w", "h"],
      "additionalProperties": false,
      "properties": {
        "w": { "type": "number", "minimum": 1 },
        "h": { "type": "number", "minimum": 1 },
        "artHeight": { "type": "number", "minimum": 1 }
      }
    },
    "tiledFramePresentation": {
      "type": "object",
      "required": ["kind", "assets", "tileSizes", "frameThickness", "contentInset"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "tiledFrame" },
        "assets": {
          "type": "object",
          "required": [
            "topLeft",
            "topCenter",
            "topRight",
            "topStretch",
            "leftStretch",
            "rightStretch",
            "bottomLeft",
            "bottomCenter",
            "bottomRight",
            "bottomStretch"
          ],
          "additionalProperties": false,
          "properties": {
            "topLeft": { "type": "string" },
            "topCenter": { "type": "string" },
            "topRight": { "type": "string" },
            "topStretch": { "type": "string" },
            "topStretch2": { "type": "string" },
            "leftStretch": { "type": "string" },
            "rightStretch": { "type": "string" },
            "bottomLeft": { "type": "string" },
            "bottomCenter": { "type": "string" },
            "bottomRight": { "type": "string" },
            "bottomStretch": { "type": "string" },
            "bottomStretch2": { "type": "string" },
            "resizeGrip": { "type": "string" }
          }
        },
        "tileSizes": {
          "type": "object",
          "required": [
            "topLeft",
            "topCenter",
            "topRight",
            "bottomLeft",
            "bottomCenter",
            "bottomRight"
          ],
          "additionalProperties": false,
          "properties": {
            "topLeft": { "$ref": "#/$defs/tiledFrameTileSize" },
            "topCenter": { "$ref": "#/$defs/tiledFrameTileSize" },
            "topRight": { "$ref": "#/$defs/tiledFrameTileSize" },
            "topStretch": { "$ref": "#/$defs/tiledFrameTileSize" },
            "topStretch2": { "$ref": "#/$defs/tiledFrameTileSize" },
            "leftStretch": { "$ref": "#/$defs/tiledFrameTileSize" },
            "rightStretch": { "$ref": "#/$defs/tiledFrameTileSize" },
            "bottomLeft": { "$ref": "#/$defs/tiledFrameTileSize" },
            "bottomCenter": { "$ref": "#/$defs/tiledFrameTileSize" },
            "bottomRight": { "$ref": "#/$defs/tiledFrameTileSize" },
            "bottomStretch": { "$ref": "#/$defs/tiledFrameTileSize" },
            "bottomStretch2": { "$ref": "#/$defs/tiledFrameTileSize" },
            "resizeGrip": { "$ref": "#/$defs/tiledFrameTileSize" }
          }
        },
        "frameThickness": { "type": "number", "minimum": 1 },
        "contentInset": {
          "type": "object",
          "required": ["left", "top", "right", "bottom"],
          "additionalProperties": false,
          "properties": {
            "left": { "type": "number", "minimum": 0 },
            "top": { "type": "number", "minimum": 0 },
            "right": { "type": "number", "minimum": 0 },
            "bottom": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "controlNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["type", "presentation"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "type": {
              "type": "string",
              "enum": [
                "button",
                "seekbar",
                "text",
                "artwork",
                "transport",
                "visualizer",
                "volume",
                "queue",
                "time",
                "playlist"
              ]
            },
            "action": { "type": "string" },
            "panelId": { "type": "string", "minLength": 1 },
            "viewId": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "minLength": 1 },
            "bind": { "type": "string" },
            "value": { "type": "string" },
            "overflow": {
              "type": "string",
              "enum": ["visible", "clip", "scroll", "scroll-bounce"],
              "description": "Runtime overflow behavior. Typography belongs in skin CSS."
            },
            "disabledWhen": { "type": "string" },
            "activeWhen": {
              "type": "string",
              "description": "When truthy, keep the pressed overlay (WMP sticky buttons)."
            },
            "sound": {
              "type": "string",
              "minLength": 1,
              "description": "Manifest soundEffects key played on click."
            },
            "tooltip": {
              "type": "string",
              "description": "OS tooltip text; supports {bind.path} placeholders."
            },
            "tooltipWhen": {
              "type": "object",
              "description": "Bind path → tooltip when truthy (last match wins).",
              "additionalProperties": { "type": "string" }
            },
            "payload": {
              "type": "object",
              "description": "Extra action payload merged at dispatch.",
              "additionalProperties": true
            },
            "presentation": { "$ref": "#/$defs/presentation" },
            "bounds": { "$ref": "#/$defs/layoutBounds" },
            "visibleWhen": { "type": "string" },
            "animations": { "type": "object" }
          }
        }
      ]
    },
    "buttonGroupNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["type", "presentation"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "buttonGroup" },
            "presentation": { "$ref": "#/$defs/buttonGroupPresentation" },
            "bounds": { "$ref": "#/$defs/layoutBounds" },
            "visibleWhen": { "type": "string" },
            "animations": { "type": "object" }
          }
        }
      ]
    },
    "slideshowNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["type", "presentation"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "type": { "const": "slideshow" },
            "presentation": { "$ref": "#/$defs/slideshowPresentation" },
            "bounds": { "$ref": "#/$defs/layoutBounds" },
            "visibleWhen": { "type": "string" },
            "animations": { "type": "object" }
          }
        }
      ]
    },
    "slideshowPresentation": {
      "type": "object",
      "required": ["kind", "assetPattern", "decks"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "imageSequence" },
        "assetPattern": {
          "type": "string",
          "minLength": 1,
          "description": "Asset path template under assets/ without extension; {deckIndex} and {page} placeholders."
        },
        "decks": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/slideshowDeck" }
        }
      }
    },
    "slideshowDeck": {
      "type": "object",
      "required": ["deckIndex", "pages"],
      "additionalProperties": false,
      "properties": {
        "deckIndex": { "type": "integer", "minimum": 1 },
        "pages": { "type": "integer", "minimum": 1 },
        "showPageNav": {
          "type": "boolean",
          "description": "When false, prev/next chrome is hidden (WMP trailer deck). Default true."
        }
      }
    },
    "eqBandNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["type", "band", "presentation"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "eqBand" },
            "band": { "type": "integer", "minimum": 1, "maximum": 10 },
            "action": { "type": "string" },
            "panelId": { "type": "string", "minLength": 1 },
            "viewId": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "minLength": 1 },
            "bind": { "type": "string" },
            "disabledWhen": { "type": "string" },
            "tooltip": {
              "type": "string",
              "description": "OS tooltip text; supports {bind.path} placeholders."
            },
            "tooltipWhen": {
              "type": "object",
              "description": "Bind path → tooltip when truthy (last match wins).",
              "additionalProperties": { "type": "string" }
            },
            "presentation": {
              "oneOf": [
                { "$ref": "#/$defs/stripSliderPresentation" },
                { "$ref": "#/$defs/bitmapVerticalSliderPresentation" }
              ]
            },
            "bounds": { "$ref": "#/$defs/layoutBounds" },
            "visibleWhen": { "type": "string" },
            "animations": { "type": "object" }
          }
        }
      ]
    },
    "balanceNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["type", "presentation"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "balance" },
            "action": { "type": "string" },
            "panelId": { "type": "string", "minLength": 1 },
            "viewId": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "minLength": 1 },
            "bind": { "type": "string" },
            "disabledWhen": { "type": "string" },
            "tooltip": {
              "type": "string",
              "description": "OS tooltip text; supports {bind.path} placeholders."
            },
            "tooltipWhen": {
              "type": "object",
              "description": "Bind path → tooltip when truthy (last match wins).",
              "additionalProperties": { "type": "string" }
            },
            "presentation": {
              "oneOf": [{ "$ref": "#/$defs/bitmapHorizontalSliderPresentation" }]
            },
            "bounds": { "$ref": "#/$defs/layoutBounds" },
            "visibleWhen": { "type": "string" },
            "animations": { "type": "object" }
          }
        }
      ]
    },
    "presentation": {
      "oneOf": [
        { "$ref": "#/$defs/bitmapPresentation" },
        { "$ref": "#/$defs/buttonGroupPresentation" },
        { "$ref": "#/$defs/gifPresentation" },
        { "$ref": "#/$defs/primitivePresentation" },
        { "$ref": "#/$defs/cssPresentation" },
        { "$ref": "#/$defs/stripSliderPresentation" },
        { "$ref": "#/$defs/bitmapVerticalSliderPresentation" },
        { "$ref": "#/$defs/bitmapHorizontalSliderPresentation" },
        { "$ref": "#/$defs/bitmapSeekbarPresentation" },
        { "$ref": "#/$defs/digitStripPresentation" },
        { "$ref": "#/$defs/framedPanelPresentation" },
        { "$ref": "#/$defs/compactPlaylistPresentation" }
      ]
    },
    "bitmapPresentation": {
      "type": "object",
      "required": ["kind", "assetBase"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "bitmap" },
        "assetBase": {
          "type": "string",
          "description": "Path under assets/ without extension, e.g. buttons/play"
        },
        "width": { "type": "number", "minimum": 1 },
        "height": { "type": "number", "minimum": 1 },
        "animatedHover": {
          "type": "boolean",
          "description": "When true, hover state uses {assetBase}-hover.gif (default and pressed remain PNG)."
        }
      }
    },
    "buttonGroupPresentation": {
      "type": "object",
      "required": ["kind", "assetBase", "positionMap", "elements"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "buttonGroup" },
        "assetBase": {
          "type": "string",
          "description": "Composite button image under assets/ without extension"
        },
        "positionMap": {
          "type": "string",
          "description": "Color-key hit map under assets/ without extension"
        },
        "width": { "type": "number", "minimum": 1 },
        "height": { "type": "number", "minimum": 1 },
        "animatedHover": { "type": "boolean" },
        "sound": {
          "type": "string",
          "minLength": 1,
          "description": "Manifest soundEffects key played on any element click in this group."
        },
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["mappingColor", "action"],
            "additionalProperties": false,
            "properties": {
              "mappingColor": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "action": { "type": "string" },
              "panelId": { "type": "string", "minLength": 1 },
              "viewId": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "minLength": 1 },
              "activeWhen": {
                "type": "string",
                "description": "When truthy, keep the pressed overlay (WMP sticky buttons)."
              },
              "disabledWhen": {
                "type": "string",
                "description": "When truthy, the element is non-interactive."
              },
              "sound": {
                "type": "string",
                "minLength": 1,
                "description": "Manifest soundEffects key; overrides group-level sound."
              },
              "tooltip": {
                "type": "string",
                "description": "OS tooltip text; supports {bind.path} placeholders."
              },
              "tooltipWhen": {
                "type": "object",
                "description": "Bind path → tooltip when truthy (last match wins).",
                "additionalProperties": { "type": "string" }
              },
              "payload": {
                "type": "object",
                "description": "Extra action payload merged at dispatch.",
                "additionalProperties": true
              }
            }
          }
        }
      }
    },
    "gifPresentation": {
      "type": "object",
      "required": ["kind", "assetBase"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "gif" },
        "assetBase": {
          "type": "string",
          "description": "Path under assets/ without extension, e.g. animations/m_idle"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1,
          "description": "Target loop duration in ms; scales frame timing to match. With completeAction, fires after one scaled loop."
        },
        "playbackRate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Multiplier on native frame delays (1 = file timing, 0.5 = half speed). Ignored when durationMs is set."
        },
        "completeAction": {
          "type": "string",
          "description": "Action dispatched after the first scaled animation loop completes."
        },
        "completePayload": {
          "type": "object",
          "description": "Payload merged when completeAction fires (e.g. view.setVariable)."
        }
      }
    },
    "primitivePresentation": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "primitive" },
        "classPrefix": { "type": "string" },
        "variant": { "type": "string" }
      }
    },
    "cssPresentation": {
      "type": "object",
      "required": ["kind", "className"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "css" },
        "className": { "type": "string" },
        "stylesheet": { "type": "string" }
      }
    },
    "stripSliderPresentation": {
      "type": "object",
      "required": ["kind", "strip", "frameWidth", "frameCount"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "stripSlider" },
        "strip": {
          "type": "string",
          "description": "Path under assets/ without extension, e.g. sliders/seek"
        },
        "positionMap": {
          "type": "string",
          "description": "Optional WMP positionImage path under assets/ without extension"
        },
        "frameWidth": { "type": "number", "minimum": 1 },
        "frameHeight": { "type": "number", "minimum": 1 },
        "frameCount": { "type": "number", "minimum": 2 },
        "direction": {
          "type": "string",
          "enum": ["horizontal", "vertical"],
          "description": "Fallback drag axis when positionMap is absent"
        },
        "invert": {
          "type": "boolean",
          "description": "Reverse pointer-to-value mapping only; display still follows playback ratio"
        },
        "classPrefix": { "type": "string" }
      }
    },
    "bitmapVerticalSliderPresentation": {
      "type": "object",
      "required": [
        "kind",
        "track",
        "thumb",
        "trackTileWidth",
        "trackTileHeight",
        "trackWidth",
        "trackHeight",
        "thumbWidth",
        "thumbHeight"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "bitmapVerticalSlider" },
        "track": {
          "type": "string",
          "description": "Track tile path under assets/ without extension (WMP slice or full-height PNG)"
        },
        "thumb": { "type": "string" },
        "trackTileWidth": {
          "type": "number",
          "minimum": 1,
          "description": "Source tile width in px"
        },
        "trackTileHeight": {
          "type": "number",
          "minimum": 1,
          "description": "Source tile height in px; when less than trackHeight, 3-slice tiling repeats the middle"
        },
        "trackWidth": { "type": "number", "minimum": 1 },
        "trackHeight": { "type": "number", "minimum": 1 },
        "thumbWidth": { "type": "number", "minimum": 1 },
        "thumbHeight": { "type": "number", "minimum": 1 },
        "borderSize": {
          "type": "number",
          "minimum": 0,
          "description": "Cap size and thumb travel inset (WMP borderSize); enables 3-slice tiling when > 0"
        },
        "fillFromBottom": {
          "type": "boolean",
          "description": "When true, the track image is a bottom-anchored value fill (WMP foregroundImage) revealed up to the current value; the empty groove is expected in the window background."
        },
        "classPrefix": { "type": "string" }
      }
    },
    "bitmapHorizontalSliderPresentation": {
      "type": "object",
      "required": [
        "kind",
        "track",
        "thumb",
        "trackTileWidth",
        "trackTileHeight",
        "trackWidth",
        "trackHeight",
        "thumbWidth",
        "thumbHeight"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "bitmapHorizontalSlider" },
        "track": {
          "type": "string",
          "description": "Track tile path under assets/ without extension (WMP slice or full-width PNG)"
        },
        "thumb": { "type": "string" },
        "trackTileWidth": {
          "type": "number",
          "minimum": 1,
          "description": "Source tile width in px; when less than trackWidth, 3-slice tiling repeats the middle"
        },
        "trackTileHeight": {
          "type": "number",
          "minimum": 1,
          "description": "Source tile height in px"
        },
        "trackWidth": { "type": "number", "minimum": 1 },
        "trackHeight": { "type": "number", "minimum": 1 },
        "thumbWidth": { "type": "number", "minimum": 1 },
        "thumbHeight": { "type": "number", "minimum": 1 },
        "borderSize": {
          "type": "number",
          "minimum": 0,
          "description": "Cap size and thumb travel inset (WMP borderSize); enables 3-slice tiling when > 0"
        },
        "classPrefix": { "type": "string" }
      }
    },
    "bitmapSeekbarPresentation": {
      "type": "object",
      "required": [
        "kind",
        "track",
        "fill",
        "thumb",
        "borderSize",
        "trackWidth",
        "trackHeight",
        "thumbWidth",
        "thumbHeight"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "bitmapSeekbar" },
        "track": {
          "type": "string",
          "description": "Track background path under assets/ without extension"
        },
        "fill": {
          "type": "string",
          "description": "Played portion fill path under assets/ without extension"
        },
        "thumb": {
          "type": "string",
          "description": "Thumb image base path; hover/pressed use -hover/-pressed suffixes"
        },
        "borderSize": {
          "type": "number",
          "minimum": 0,
          "description": "Inset from each track edge for thumb travel (WMP borderSize)"
        },
        "trackWidth": { "type": "number", "minimum": 1 },
        "trackHeight": { "type": "number", "minimum": 1 },
        "thumbWidth": { "type": "number", "minimum": 1 },
        "thumbHeight": { "type": "number", "minimum": 1 },
        "classPrefix": { "type": "string" }
      }
    },
    "digitStripPresentation": {
      "type": "object",
      "required": ["kind", "strip", "frameWidth", "frameHeight", "slots"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "digitStrip" },
        "strip": {
          "type": "string",
          "description": "Path under assets/ without extension, e.g. time/numbers"
        },
        "frameWidth": { "type": "number", "minimum": 1 },
        "frameHeight": { "type": "number", "minimum": 1 },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/digitStripSlot" }
        },
        "signFrameElapsed": {
          "type": "integer",
          "minimum": 0,
          "description": "Strip frame for elapsed separator (WMP default 10)"
        },
        "signFrameRemaining": {
          "type": "integer",
          "minimum": 0,
          "description": "Strip frame for remaining prefix (WMP default 11)"
        },
        "classPrefix": { "type": "string" }
      }
    },
    "framedPanelPresentation": {
      "type": "object",
      "required": ["kind", "mask"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "framedPanel" },
        "mask": {
          "type": "string",
          "description": "Path under assets/ without extension. Opaque pixels define the visible viz area (WMP clippingColor hole)."
        },
        "frame": {
          "type": "string",
          "description": "Optional frame overlay path under assets/ without extension (WMP vid_bkgd border)."
        },
        "contentInset": { "$ref": "#/$defs/framedPanelInset" },
        "classPrefix": { "type": "string" }
      }
    },
    "compactPlaylistPresentation": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "compact" },
        "showDropdown": {
          "type": "boolean",
          "description": "Show source dropdown (All tracks, Up Next, user playlists). Default true."
        },
        "showDuration": {
          "type": "boolean",
          "description": "Show track duration column. Default true."
        }
      }
    },
    "framedPanelInset": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "w": { "type": "number", "minimum": 1 },
        "h": { "type": "number", "minimum": 1 }
      }
    },
    "digitStripSlot": {
      "type": "object",
      "required": ["role", "x"],
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "sign",
            "minuteTens",
            "minuteOnes",
            "secondTens",
            "secondOnes"
          ]
        },
        "x": { "type": "number", "minimum": 0 }
      }
    },
    "visualizerSize": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "oneOf": [
            { "type": "string", "const": "fill" },
            { "type": "integer", "minimum": 1 }
          ],
          "description": "fill = 100% of slot width; integer = fixed px"
        },
        "height": {
          "oneOf": [
            { "type": "string", "enum": ["flex", "fill"] },
            { "type": "integer", "minimum": 1 }
          ],
          "description": "flex = grow in shell; fill = 100% of slot; integer = fixed px"
        },
        "minHeight": { "type": "integer", "minimum": 1 },
        "maxHeight": { "type": "integer", "minimum": 1 }
      }
    },
    "windowChrome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clipMask": { "type": "string" },
        "defaultWidth": { "type": "integer", "minimum": 200 },
        "defaultHeight": { "type": "integer", "minimum": 200 },
        "minWidth": { "type": "integer", "minimum": 160 },
        "minHeight": { "type": "integer", "minimum": 160 },
        "maxWidth": { "type": "integer", "minimum": 200 },
        "maxHeight": { "type": "integer", "minimum": 200 },
        "resizable": { "type": "boolean" },
        "snapEnabled": { "type": "boolean" }
      }
    }
  }
}
