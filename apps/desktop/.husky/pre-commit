# Hooks run from the monorepo root. Desktop checks only apply when desktop (or the
# shared format crate / workspace manifests it builds against) is staged.
staged="$(git diff --cached --name-only --diff-filter=ACMR)"

if echo "$staged" | grep -qE '^(apps/desktop/|libs/spk-format/|Cargo\.(toml|lock)$)'; then
  cd "$(git rev-parse --show-toplevel)/apps/desktop"

  npx lint-staged

  # Dependencies changed: refresh the third-party license bundle and stage it, so
  # About > Licenses and src-tauri/NOTICE never drift from the lockfiles.
  if echo "$staged" | grep -qE '^(apps/desktop/(package\.json|package-lock\.json|src-tauri/Cargo\.toml|scripts/(generate-notice\.mjs|license-overrides\.json|lib/license-bundle\.mjs|license-templates/))|Cargo\.(toml|lock)$)'; then
    npm run notice:generate
    git add src-tauri/NOTICE src/assets/licenses/third-party.json
  fi


  npm run test
fi
