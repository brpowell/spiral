{
  "name": "spiral",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.2.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:agent": "tauri dev --features agent-bridge",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "vitest run",
    "test:backend": "cd src-tauri && cargo test --features dev-bins",
    "lint": "eslint . && npm run lint:i18n && npm run lint:rust",
    "lint:commit": "commitlint --last --verbose",
    "lint:fix": "eslint . --fix",
    "lint:i18n": "node scripts/check-i18n-keys.mjs",
    "lint:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "lint:skins": "vitest run src/lib/skinLayout.test.ts",
    "format": "npm run format:prettier && npm run format:rust",
    "format:check": "npm run format:prettier:check",
    "format:prettier": "prettier --write .",
    "format:prettier:check": "prettier --check .",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "wms-import": "cargo run --manifest-path src-tauri/Cargo.toml --features dev-bins --bin wms_import --",
    "read-tags": "cargo run --manifest-path src-tauri/Cargo.toml --features dev-bins --bin read_tags --",
    "tauri": "tauri",
    "prepare": "cd ../.. && husky apps/desktop/.husky",
    "version:check": "node scripts/check-version-sync.mjs",
    "tauri:versions:check": "node scripts/check-tauri-versions.mjs",
    "notice:check": "node scripts/generate-notice.mjs --check",
    "notice:generate": "node scripts/generate-notice.mjs",
    "clean:target": "cd src-tauri && cargo clean",
    "profile:build": "node scripts/profile-build.mjs",
    "release": "node scripts/release/cli.mjs"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@tanstack/react-virtual": "^3.14.2",
    "@tauri-apps/api": "2.11",
    "@tauri-apps/plugin-dialog": "2.7",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "framer-motion": "^12.38.0",
    "gifuct-js": "^2.1.2",
    "i18next": "^26.3.6",
    "node-vibrant": "^4.0.4",
    "postcss": "^8.5.25",
    "postcss-prefix-selector": "^2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.184.0",
    "zustand": "^5.0.5"
  },
  "overrides": {
    "file-type": "^21.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "happy-dom": "^20.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,html,yml,yaml}": [
      "prettier --write"
    ],
    "src-tauri/**/*.rs": "rustfmt"
  }
}
