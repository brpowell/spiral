{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spiral",
  "version": "0.3.0",
  "identifier": "com.spiralpowered.music",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost blob: data:",
        "media-src": "'self' asset: http://asset.localhost https://asset.localhost blob:",
        "font-src": "'self' data: asset: http://asset.localhost https://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost asset: http://asset.localhost https://asset.localhost https://spiralpowered.com",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:1420 http://127.0.0.1:1420",
        "script-src": "'self' 'unsafe-eval' 'unsafe-inline' blob: http://localhost:1420 http://127.0.0.1:1420",
        "style-src": "'self' 'unsafe-inline' http://localhost:1420 http://127.0.0.1:1420",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost blob: data: http://localhost:1420 http://127.0.0.1:1420",
        "media-src": "'self' asset: http://asset.localhost https://asset.localhost blob:",
        "font-src": "'self' data: asset: http://asset.localhost https://asset.localhost http://localhost:1420 http://127.0.0.1:1420",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost asset: http://asset.localhost https://asset.localhost http://localhost:1420 http://127.0.0.1:1420 ws://localhost:1420 ws://localhost:1421 ws://127.0.0.1:1420 ws://127.0.0.1:1421 https://spiralpowered.com http://127.0.0.1:3000 http://localhost:3000",
        "worker-src": "'self' blob: http://localhost:1420 http://127.0.0.1:1420",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**/*",
          "$APPLOCALDATA/**/*",
          "$APPDATA/**/*",
          "$RESOURCE/**/*",
          "$MUSIC/**/*",
          "$AUDIO/**/*",
          "$DOWNLOAD/**/*",
          "$DESKTOP/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis",
      "app",
      "dmg"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "packs/builtin": "packs/builtin",
      "NOTICE": "NOTICE"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5QURBREY1NkZFNDEwQ0EKUldUS0VPUnY5YTJ0bVdkS01HdGNjbVFrb0hWYVJkVHU2OWxGcDc5WEVuTWl2N1RhSUlSdjYrZXcK",
      "endpoints": [
        "https://spiralpowered.com/api/updates/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
