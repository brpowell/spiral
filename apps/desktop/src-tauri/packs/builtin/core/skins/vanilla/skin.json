{
  "$schema": "https://raw.githubusercontent.com/brpowell/spiral/main/libs/spk-format/schemas/skin-v1.schema.json",
  "id": "vanilla",
  "name": "Vanilla",
  "author": "Spiral",
  "description": "Default skin out of the box.",
  "preview": "preview.png",
  "stylesheet": "skin.css",
  "views": {
    "standard": {
      "state": {
        "playlist": {
          "default": "closed",
          "on": {
            "toggle": [
              {
                "from": [
                  "closed"
                ],
                "set": "open"
              },
              {
                "from": [
                  "open"
                ],
                "set": "closed"
              }
            ]
          }
        }
      },
      "window": {
        "defaultWidth": 320,
        "defaultHeight": 468,
        "minWidth": 256,
        "minHeight": 386,
        "maxWidth": 420,
        "maxHeight": 588,
        "resizable": true,
        "snapEnabled": true
      },
      "layout": {
        "id": "root",
        "type": "column",
        "children": [
          {
            "type": "row",
            "id": "window-chrome",
            "dragRegion": true,
            "children": [
              {
                "type": "button",
                "id": "chrome-picker",
                "onClick": [
                  {
                    "action": "skin.openPicker"
                  }
                ],
                "presentation": {
                  "kind": "primitive",
                  "icon": "palette"
                }
              },
              {
                "type": "button",
                "id": "chrome-pin",
                "onClick": [
                  {
                    "action": "skin.toggleAlwaysOnTop"
                  }
                ],
                "presentation": {
                  "kind": "primitive",
                  "icon": "alwaysOnTop"
                }
              },
              {
                "type": "button",
                "id": "chrome-restore",
                "onClick": [
                  {
                    "action": "skin.restoreMainWindow"
                  }
                ],
                "presentation": {
                  "kind": "primitive",
                  "icon": "maximize"
                }
              },
              {
                "type": "button",
                "id": "chrome-close",
                "onClick": [
                  {
                    "action": "app.quit"
                  }
                ],
                "presentation": {
                  "kind": "primitive",
                  "icon": "close"
                }
              }
            ]
          },
          {
            "type": "column",
            "id": "contents",
            "children": [
              {
                "type": "overlay",
                "id": "visualizer-stack",
                "children": [
                  {
                    "type": "overlay",
                    "id": "crt-screen",
                    "children": [
                      {
                        "type": "visualizer",
                        "id": "visualizer",
                        "presentation": {
                          "kind": "primitive"
                        }
                      },
                      {
                        "type": "overlay",
                        "id": "playlist-overlay",
                        "children": [
                          {
                            "type": "playlist",
                            "id": "playlist-view",
                            "defaultSource": "upNext",
                            "showArtwork": true
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "row",
                    "id": "viz-cycle",
                    "children": [
                      {
                        "type": "button",
                        "className": "viz-btn",
                        "onClick": [
                          {
                            "action": "visualizer.previous"
                          }
                        ],
                        "enabledWhen": "visualizer.canGoPrevious",
                        "presentation": {
                          "kind": "primitive",
                          "icon": "chevronLeft"
                        }
                      },
                      {
                        "type": "button",
                        "className": "viz-btn",
                        "onClick": [
                          {
                            "action": "visualizer.next"
                          }
                        ],
                        "enabledWhen": "visualizer.canGoNext",
                        "presentation": {
                          "kind": "primitive",
                          "icon": "chevronRight"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "type": "row",
                "id": "now-playing",
                "children": [
                  {
                    "type": "artwork",
                    "id": "artwork",
                    "presentation": {
                      "kind": "primitive"
                    }
                  },
                  {
                    "type": "column",
                    "id": "track-info",
                    "children": [
                      {
                        "type": "text",
                        "id": "track-title",
                        "bind": "track.title",
                        "overflow": "scroll-bounce"
                      },
                      {
                        "type": "text",
                        "id": "track-artist",
                        "bind": "track.artist",
                        "overflow": "scroll-bounce",
                        "visibleWhen": "player.hasTrack"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "slider",
                "id": "seekbar",
                "presentation": {
                  "kind": "primitive"
                },
                "control": "seek"
              },
              {
                "type": "row",
                "id": "transport-deck",
                "children": [
                  {
                    "type": "button",
                    "id": "shuffle",
                    "sound": "spiral.core.sound.control",
                    "onClick": [
                      {
                        "action": "player.toggleShuffle"
                      }
                    ],
                    "activeWhen": "player.shuffle",
                    "presentation": {
                      "kind": "primitive",
                      "variant": "secondary",
                      "icon": "shuffle"
                    }
                  },
                  {
                    "type": "button",
                    "id": "previous",
                    "sound": "spiral.core.sound.control",
                    "onClick": [
                      {
                        "action": "player.previousTrack"
                      }
                    ],
                    "enabledWhen": "player.canGoPrevious",
                    "presentation": {
                      "kind": "primitive",
                      "variant": "secondary",
                      "icon": "previous"
                    }
                  },
                  {
                    "type": "button",
                    "id": "play",
                    "sound": "spiral.core.sound.play",
                    "soundWhen": {
                      "player.isPlaying": "spiral.core.sound.control"
                    },
                    "onClick": [
                      {
                        "action": "player.togglePlayPause"
                      }
                    ],
                    "presentation": {
                      "kind": "primitive",
                      "variant": "primary",
                      "icon": "play",
                      "iconWhen": {
                        "player.isPlaying": "pause"
                      }
                    }
                  },
                  {
                    "type": "button",
                    "id": "next",
                    "sound": "spiral.core.sound.control",
                    "onClick": [
                      {
                        "action": "player.nextTrack"
                      }
                    ],
                    "enabledWhen": "player.canGoNext",
                    "presentation": {
                      "kind": "primitive",
                      "variant": "secondary",
                      "icon": "next"
                    }
                  },
                  {
                    "type": "button",
                    "id": "repeat",
                    "sound": "spiral.core.sound.control",
                    "onClick": [
                      {
                        "action": "player.cycleRepeat"
                      }
                    ],
                    "activeWhen": "player.repeatOn",
                    "presentation": {
                      "kind": "primitive",
                      "variant": "secondary",
                      "icon": "repeat",
                      "iconWhen": {
                        "player.repeatOne": "repeatOne"
                      }
                    }
                  }
                ]
              },
              {
                "type": "row",
                "id": "footer-row",
                "children": [
                  {
                    "type": "slider",
                    "presentation": {
                      "kind": "primitive"
                    },
                    "control": "volume"
                  },
                  {
                    "type": "button",
                    "id": "playlist-toggle",
                    "onClick": [
                      {
                        "action": "state.applyEvent",
                        "payload": {
                          "variable": "playlist",
                          "event": "toggle"
                        }
                      }
                    ],
                    "activeWhen": "state.playlist.open",
                    "tooltip": "Playlist",
                    "presentation": {
                      "kind": "primitive",
                      "icon": "setList"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  }
}
