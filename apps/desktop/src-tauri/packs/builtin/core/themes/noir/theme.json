{
  "$schema": "https://raw.githubusercontent.com/spiral-powered/spk-format/main/schemas/theme-v1.schema.json",
  "id": "noir",
  "name": "Noir",
  "author": "Spiral",
  "description": "Warm charcoal, stark white, and a cinematic red.",
  "tokens": {
    "color-bg": "#181512",
    "color-text-primary": "#f6f1e8",
    "color-accent": "#e63946",
    "color-danger": "#ff5c5c",
    "color-alert-info": "#b7b4e4",
    "color-alert-success": "#7dcea0",
    "color-alert-warning": "#e8c56a",
    "radius-card": "12px",
    "radius-button": "8px",
    "radius-input": "8px",
    "font-ui": "'Helvetica Neue', Helvetica, Arial, sans-serif"
  }
}
