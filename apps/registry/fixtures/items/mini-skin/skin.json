{
  "id": "mini-skin",
  "publisherId": "spiral",
  "version": "1.0.0",
  "name": "Mini Skin",
  "author": "Spiral",
  "description": "Minimal skin fixture for publish tests and the seed.",
  "views": {
    "main": {
      "presentation": "primary",
      "layout": {
        "type": "canvas",
        "width": 64,
        "height": 64,
        "children": [
          {
            "type": "button",
            "id": "mini-switch",
            "onClick": [
              {
                "action": "skin.switchView",
                "payload": {
                  "viewId": "mini"
                }
              }
            ],
            "bounds": {
              "x": 0,
              "y": 0,
              "w": 21,
              "h": 21,
              "zIndex": 1
            },
            "presentation": {
              "kind": "bitmap",
              "width": 21,
              "height": 21,
              "assets": {
                "default": "buttons/mini-switch.png",
                "hover": "buttons/mini-switch-hover.png",
                "pressed": "buttons/mini-switch-pressed.png"
              }
            }
          }
        ]
      }
    },
    "mini": {
      "presentation": "exclusive",
      "layout": {
        "type": "canvas",
        "width": 32,
        "height": 32,
        "children": []
      }
    }
  }
}
